{
  "name": "miapp",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "b": "pnpm --filter @miapp/backend",
    "w": "pnpm --filter @miapp/webapp",
    "dev": "pnpm -r --parallel dev",
    "types": "concurrently \"pnpm --filter @miapp/backend types\" \"pnpm --filter @miapp/webapp types\"",
    "prettify": "pnpm -r --parallel prettify",
    "lint": "concurrently \"pnpm --filter @miapp/backend lint\" \"pnpm --filter @miapp/webapp lint\"",
    "lint:fix": "concurrently \"pnpm --filter @miapp/backend lint:fix\" \"pnpm --filter @miapp/webapp lint:fix\"",
    "format:check": "pnpm -r --parallel format:check",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.0.2",
    "rimraf": "^5.0.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
