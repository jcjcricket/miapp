{
  "name": "@miapp/webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache --ext .ts,.tsx .",
    "stylelint": "stylelint --cache --cache-location ./node_modules/.cache/.stylelintcache src/**/*.scss",
    "stylelint:fix": "stylelint --cache --cache-location ./node_modules/.cache/.stylelintcache src/**/*.scss --fix",
    "lint:fix": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache --ext .ts,.tsx . --fix",
    "preview": "vite preview",
    "prettify": "prettier --log-level warn --cache --write src package.json tsconfig.json tsconfig.node.json vite.config.ts index.html .eslintrc.yml .lintstagedrc.yml",
    "format:check": "prettier --log-level warn --cache --check src package.json tsconfig.json tsconfig.node.json vite.config.ts index.html .eslintrc.yml .lintstagedrc.yml",
    "types": "tsc --noEmit --project ./tsconfig.json && tsc --noEmit --project ./tsconfig.node.json",
    "stylecheck": "sass --update -q ./src:./node_modules/.cache/.stylecheckcache"
  },
  "dependencies": {
    "@miapp/backend": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "formik": "^2.4.9",
    "formik-validator-zod": "^2.2.0",
    "include-media": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "reset-css": "^5.0.2",
    "sass": "^1.104.1",
    "zod": "^3.25.76",
    "zod-formik-adapter": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "prettier": "^3.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^4.4.5"
  }
}
